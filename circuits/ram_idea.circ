  <circuit name="D_latch_with_activation">
    <a name="circuit" val="D_latch_with_activation"/>
    <a name="circuitnamedboxfixedsize" val="true"/>
    <a name="simulationFrequency" val="1024.0"/>
    <comp lib="0" loc="(290,140)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="label" val="D"/>
    </comp>
    <comp lib="0" loc="(290,210)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="label" val="Write_Data"/>
    </comp>
    <comp lib="0" loc="(290,250)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="label" val="Activate"/>
    </comp>
    <comp lib="0" loc="(700,200)" name="Transistor">
      <a name="facing" val="north"/>
      <a name="selloc" val="bl"/>
      <a name="type" val="n"/>
    </comp>
    <comp lib="0" loc="(700,240)" name="Ground"/>
    <comp lib="0" loc="(720,200)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="facing" val="west"/>
      <a name="label" val="Q"/>
      <a name="type" val="output"/>
    </comp>
    <comp lib="1" loc="(340,220)" name="AND Gate">
      <a name="size" val="30"/>
    </comp>
    <comp lib="1" loc="(460,150)" name="NAND Gate">
      <a name="size" val="30"/>
    </comp>
    <comp lib="1" loc="(460,220)" name="NAND Gate">
      <a name="size" val="30"/>
    </comp>
    <comp lib="1" loc="(550,150)" name="NAND Gate">
      <a name="size" val="30"/>
    </comp>
    <comp lib="1" loc="(550,220)" name="NAND Gate">
      <a name="size" val="30"/>
    </comp>
    <comp lib="1" loc="(680,220)" name="AND Gate">
      <a name="size" val="30"/>
    </comp>
    <comp lib="9" loc="(405,340)" name="Text">
      <a name="text" val="PS: Logisim is not powerful enough to simulate real latch circuit used in RAM ICs"/>
    </comp>
    <comp lib="9" loc="(405,365)" name="Text">
      <a name="text" val="I am using a D latch in its place for the lack of a better option! :)"/>
    </comp>
    <comp lib="9" loc="(410,35)" name="Text">
      <a name="text" val="Activation signal outputs the data stored in the memory cell onto the bit line"/>
    </comp>
    <comp lib="9" loc="(410,470)" name="Text">
      <a name="text" val="it is up to the software to initialise it. In Logisim, however, RAM is always filled with 0s :("/>
    </comp>
    <comp lib="9" loc="(415,425)" name="Text">
      <a name="text" val="Observe that the initial value of the latch is shown in red, it means that logisim is unable"/>
    </comp>
    <comp lib="9" loc="(420,60)" name="Text">
      <a name="text" val="It also allows Write_Data signal to change value stored in the cell to the value supplied on input D"/>
    </comp>
    <comp lib="9" loc="(425,445)" name="Text">
      <a name="text" val="to determine it. This is true to reality, because physical RAM content appears random on power up"/>
    </comp>
